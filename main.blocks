<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" x="10" y="10"><statement name="HANDLER"><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum Element {" line1="    Fire," line2="    Water," line3="    Ground," line4="    Air," line5="}" numlines="6"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Card {" line1="    name:string" line2="    image:Image" line3="    damage:number" line4="    defense:number" line5="    cost:number" line6="    materialize:Element" line7="    consume:Element" line8="    fullCardImage:Image" line9="    constructor(name:string,image:Image,damage:number,defense:number,cost:number,materialize:Element,consume:Element){" line10="        this.damage=damage" line11="        this.defense=defense" line12="        this.cost=cost" line13="        this.materialize=materialize" line14="        this.consume=consume" line15="        this.image=image" line16="        this.name=name" line17="    }" line18="    " line19="    createCard(){" line20="        // 1. Draw the small card on a separate 24x40 image" line21="        let smallCard = image.create(24, 40)" line22="        smallCard.drawRect(0, 0, 24, 40, 5)" line23="        smallCard.fillRect(1, 1, 22, 38, 10)" line24="        smallCard.drawImage(this.image, 2, 7) // Now centers properly within 24px!" line25="" line26="        // 2. Create the 48x80 destination image and blit smallCard onto it" line27="        this.fullCardImage = image.create(48, 80)" line28="        this.fullCardImage.blit(0, 0, 48, 80, smallCard, 0, 0, 24, 40, true, false)" line29="        this.fullCardImage.printCenter(this.name, 5, 7, YourCustomFont)" line30="" line31="    }" line32="}" numlines="33"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="const YourCustomFont: image.Font = {" line1="    charWidth: 6," line2="    charHeight: 5," line3="    // To view/save a custom font, paste your font data there! In beteen those ` `" line4="    data: hex``" line5="    // Then change the font on line 15 to be your custom one! For example: let font = YourCustomFont" line6="}" numlines="7" declaredvars="YourCustomFont"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum Intents{" line1="    Attack," line2="    Debuff," line3="    Buff," line4="    DestroyElement," line5="    CreateCurse" line6="}" numlines="7"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="interface EnemyAction{" line1="    intent:Intents" line2="    identifier?:number|Element" line3="}" numlines="4"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Enemy {" line1="    health: number" line2="    private index: number;" line3="    enemyBehavior: () =&gt; void;" line4="    currentEnemyIntent:EnemyAction" line5="    allIntents: EnemyAction[]" line6="}" numlines="7"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let richard= new Card(&quot;hmm&quot;,assets.image`myImage`,5,0,1,null,null)" numlines="1" declaredvars="richard"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="richard.createCard()" numlines="1"></mutation><next><block type="typescript_statement"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.onPaint(()=&gt;{screen.drawImage(richard.fullCardImage,0,0)})" numlines="1"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>